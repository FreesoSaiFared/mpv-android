[Unit]
Description=Morning Show central recorder and playback clock
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/mnt/SERVE/projects/mpv-commentary-cinema
ExecStart=/mnt/SERVE/projects/mpv-commentary-cinema/central/.venv/bin/gunicorn -b 127.0.0.1:18767 -w 1 --threads 4 --timeout 180 central.server:app
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
